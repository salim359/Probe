{
  "name": "probe-2.0-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Probe 2.0 AWS Lambda handlers",
  "scripts": {
    "build": "PATH=\"$PWD/node_modules/.bin:$PATH\" sam build",
    "deploy": "npm run build && sam deploy --guided",
    "deploy:ci": "npm run build && sam deploy",
    "local": "npm run build && PATH=\"$PWD/node_modules/.bin:$PATH\" sam local start-api"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1160.0",
    "@aws-sdk/client-budgets": "^3.1160.0",
    "@aws-sdk/client-cloudformation": "^3.1160.0",
    "@aws-sdk/client-cloudwatch": "^3.1160.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1160.0",
    "@aws-sdk/client-dynamodb": "^3.1160.0",
    "@aws-sdk/client-ec2": "^3.1160.0",
    "@aws-sdk/client-lambda": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1160.0",
    "@aws-sdk/client-sns": "^3.1160.0",
    "@aws-sdk/client-sqs": "^3.1160.0",
    "@aws-sdk/client-sts": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "openai": "^7.45.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
