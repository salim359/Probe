version = 0.1

# Copy to samconfig.toml and edit for your account (samconfig.toml is gitignored).
#   cp samconfig.toml.example samconfig.toml

[default.global.parameters]
stack_name = "aws-troubleshoot-assistant"
region = "us-east-1"

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
parameter_overrides = "InvestigationRegion=us-east-1 LogLookbackMinutes=60 MaxLogEvents=50 CreateLexBot=true OpenAIParameterName=add your api key path here"

[default.local_invoke.parameters]
# Example: sam local invoke TroubleshootingFunction -e events/direct-investigate.json
